# Production Environment Variables Template
# Copy this file to .env.production and fill in the values

# Django Settings
SECRET_KEY=your-secret-key-here-generate-with-django-get-random-secret-key
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database Configuration
DB_NAME=ano_db
DB_USER=ano_user
DB_PASSWORD=your-secure-database-password
DB_HOST=postgres
DB_PORT=5432

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email Configuration (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Frontend URL
FRONTEND_URL=https://yourdomain.com

# Gunicorn Configuration
GUNICORN_WORKERS=4
GUNICORN_THREADS=2

# Django Superuser (for initial setup)
DJANGO_SUPERUSER_EMAIL=admin@iiti.ac.in
DJANGO_SUPERUSER_PASSWORD=your-secure-admin-password

# Security Settings
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# File Upload Settings
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/wav,audio/ogg

# Rate Limiting
RATE_LIMIT_LOGIN=5/hour
RATE_LIMIT_API=100/minute
RATE_LIMIT_WEBSOCKET=50/minute

# Logging
LOG_LEVEL=INFO
